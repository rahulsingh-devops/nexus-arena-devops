# Nexus Arena — Environment Variables
# Copy this file to .env and adjust values for your environment

# Backend
PORT=3001
NODE_ENV=development
JWT_SECRET=nexus-arena-dev-secret-change-in-production
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (optional - falls back to in-memory if not available)
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexusarena

# Redis (optional - falls back to in-memory if not available)
REDIS_URL=redis://localhost:6379

# Frontend (prefix with VITE_)
VITE_BACKEND_URL=http://localhost:3001
